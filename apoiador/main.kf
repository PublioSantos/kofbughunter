class Verdict {
    String kind
    String code
    String detail
    constructor(k: String, c: String, d: String) { kind = k; code = c; detail = d }
    signature(): String {
        if (code == "") { return kind }
        // the VerifyError reason is the real discriminator; without it every
        // backend fault collapses into one bucket and dedup stops being useful
        if (code == "VerifyError") { return kind + ":" + code + ":" + detail }
        return kind + ":" + code
    }
}

readAll(p: String): String {
    var txt = File(p).readText()
    if (txt != null) { return txt }
    return ""
}

readLines(p: String): List<String> {
    var out: List<String> = listOf()
    var txt = File(p).readText()
    if (txt != null) {
        var parts: String[] = txt.split("\n")
        for (var x in parts) { out.add(x) }
    }
    return out
}

charAtStr(s: String, i: Int): String {
    return s.substring(i, i + 1)
}

// hand-rolled split: String.split() takes a regex upstream, and "." is exactly
// the separator a version string needs
splitOn(s: String, sep: String): List<String> {
    var out: List<String> = listOf()
    var rest: String = s
    var at: Int = rest.indexOf(sep)
    while (at >= 0) {
        out.add(rest.substring(0, at))
        rest = rest.substring(at + sep.length(), rest.length())
        at = rest.indexOf(sep)
    }
    out.add(rest)
    return out
}

rankOf(c: String): Int {
    var alphabet: String = "0123456789abcdefghijklmnopqrstuvwxyz"
    return alphabet.indexOf(c)
}

lexCmp(a: String, b: String): Int {
    var i: Int = 0
    while (i < a.length()) {
        if (i >= b.length()) { return 1 }
        var ca: String = charAtStr(a, i)
        var cb: String = charAtStr(b, i)
        if (ca != cb) {
            if (rankOf(ca) > rankOf(cb)) { return 1 }
            return 0 - 1
        }
        i = i + 1
    }
    if (b.length() > a.length()) { return 0 - 1 }
    return 0
}

stripZeros(s: String): String {
    var out: String = s
    while (out.length() > 1) {
        if (charAtStr(out, 0) != "0") { return out }
        out = out.substring(1, out.length())
    }
    return out
}

// compares decimal segments without parsing them: once leading zeros are gone,
// the longer digit string is always the larger number (so 10 > 2, which a plain
// string compare gets wrong)
cmpNumeric(a: String, b: String): Int {
    var na: String = stripZeros(a)
    var nb: String = stripZeros(b)
    if (na.length() > nb.length()) { return 1 }
    if (na.length() < nb.length()) { return 0 - 1 }
    return lexCmp(na, nb)
}

coreOf(v: String): String {
    var dash: Int = v.indexOf("-")
    if (dash < 0) { return v }
    return v.substring(0, dash)
}

suffixOf(v: String): String {
    var dash: Int = v.indexOf("-")
    if (dash < 0) { return "" }
    return v.substring(dash + 1, v.length())
}

cmpVersion(a: String, b: String): Int {
    var pa: List<String> = splitOn(coreOf(a), ".")
    var pb: List<String> = splitOn(coreOf(b), ".")
    var n: Int = pa.size()
    if (pb.size() > n) { n = pb.size() }
    var i: Int = 0
    while (i < n) {
        var sa: String = "0"
        var sb: String = "0"
        if (i < pa.size()) { sa = pa.get(i) }
        if (i < pb.size()) { sb = pb.get(i) }
        var c: Int = cmpNumeric(sa, sb)
        if (c != 0) { return c }
        i = i + 1
    }
    // same numbers: a final release outranks any pre-release of it
    var xa: String = suffixOf(a)
    var xb: String = suffixOf(b)
    if (xa == "") {
        if (xb == "") { return 0 }
        return 1
    }
    if (xb == "") { return 0 - 1 }
    return lexCmp(xa, xb)
}

extractBracketCode(line: String): String {
    var open: Int = 0 - 1
    var i: Int = 0
    while (i < line.length()) {
        if (charAtStr(line, i) == "[") { open = i }
        i = i + 1
    }
    if (open < 0) { return "" }
    var j: Int = open + 1
    while (j < line.length()) {
        if (charAtStr(line, j) == "]") { return line.substring(open + 1, j) }
        j = j + 1
    }
    return ""
}

afterMarker(line: String, marker: String): String {
    var at: Int = line.indexOf(marker)
    if (at < 0) { return "" }
    return line.substring(at + marker.length(), line.length()).trim()
}

classify(buildTxt: String, runTxt: String, expected: String): Verdict {
    if (buildTxt.contains("COMP002")) {
        return Verdict("ICE", "COMP002", "compiler crash in JVM backend")
    }
    var buildLines: List<String> = listOf()
    var bparts: String[] = buildTxt.split("\n")
    for (var b in bparts) { buildLines.add(b) }
    for (var line in buildLines) {
        if (line.contains("error:")) {
            var code: String = extractBracketCode(line)
            if (code != "") {
                var kind: String = "SEM"
                if (code.startsWith("PARSE")) { kind = "PARSE" }
                if (code.startsWith("LEX")) { kind = "LEX" }
                if (code.startsWith("PKG")) { kind = "PKG" }
                return Verdict(kind, code, line.trim())
            }
        }
    }
    if (runTxt.contains("VerifyError")) {
        // the JVM's headline reason is the discriminator; the explanatory lines
        // below it ("not assignable") repeat across unrelated faults
        var reason: String = "unspecified"
        if (runTxt.contains("not assignable")) { reason = "bad-assignability" }
        if (runTxt.contains("Inconsistent stackmap")) { reason = "inconsistent-stackmap" }
        if (runTxt.contains("Bad type on operand stack")) { reason = "bad-operand-type" }
        if (runTxt.contains("Operand stack underflow")) { reason = "stack-underflow" }
        if (runTxt.contains("Attempt to pop empty stack")) { reason = "stack-underflow" }
        if (runTxt.contains("Bad return type")) { reason = "bad-return-type" }
        return Verdict("RUNTIME", "VerifyError", reason)
    }
    if (runTxt.contains("NoClassDefFoundError")) {
        return Verdict("RUNTIME", "NoClassDefFoundError", afterMarker(runTxt, "NoClassDefFoundError:"))
    }
    if (runTxt.contains("NoSuchMethodError")) {
        return Verdict("RUNTIME", "NoSuchMethodError", afterMarker(runTxt, "NoSuchMethodError:"))
    }
    if (runTxt.contains("ClassCastException")) {
        return Verdict("RUNTIME", "ClassCastException", "generic type args not enforced")
    }
    if (runTxt.contains("ClassFormatError")) {
        return Verdict("RUNTIME", "ClassFormatError", afterMarker(runTxt, "ClassFormatError:"))
    }
    if (runTxt.contains("IncompatibleClassChangeError")) {
        return Verdict("RUNTIME", "IncompatibleClassChangeError", "")
    }
    if (runTxt.contains("AbstractMethodError")) {
        return Verdict("RUNTIME", "AbstractMethodError", "")
    }
    if (runTxt.contains("IllegalAccessError")) {
        return Verdict("RUNTIME", "IllegalAccessError", "")
    }
    if (runTxt.contains("InstantiationError")) {
        return Verdict("RUNTIME", "InstantiationError", "")
    }
    // the launcher reports a malformed/missing main(String[]) as a JavaFX problem,
    // in whatever locale the JDK is running; match the stable tokens, not the prose
    var lower: String = runTxt.toLowerCase()
    if (lower.contains("javafx")) {
        return Verdict("RUNTIME", "BadMainClass", "launcher rejected Default.Main - main(String[]) missing or malformed")
    }
    if (lower.contains("classnotfoundexception")) {
        return Verdict("RUNTIME", "NoMainClass", "Default.Main absent - build produced no entry class")
    }
    if (buildTxt.contains("error:")) {
        return Verdict("BUILD", "uncoded", "compile error without a bracket code")
    }
    if (expected.trim() != "") {
        if (runTxt.trim() != expected.trim()) {
            return Verdict("WRONGOUTPUT", "SilentMismatch", "compiles and runs, but output differs from expected")
        }
    }
    return Verdict("CLEAN", "", "compiled and ran without a detected fault")
}

diffReport(runTxt: String, expected: String) {
    var exp: List<String> = listOf()
    var got: List<String> = listOf()
    var eparts: String[] = expected.trim().split("\n")
    for (var e in eparts) { exp.add(e) }
    var gparts: String[] = runTxt.trim().split("\n")
    for (var g in gparts) { got.add(g) }
    var n: Int = exp.size()
    if (got.size() > n) { n = got.size() }
    println("")
    println("line   expected                       actual")
    var i: Int = 0
    while (i < n) {
        var e: String = "<missing>"
        var g: String = "<missing>"
        if (i < exp.size()) { e = exp.get(i) }
        if (i < got.size()) { g = got.get(i) }
        var mark: String = "  "
        if (e != g) { mark = "->" }
        println(mark + pad("" + (i + 1), 5) + pad(e, 31) + g)
        i = i + 1
    }
}

dedupLookup(dbPath: String, sig: String): List<String> {
    var hits: List<String> = listOf()
    var lines: List<String> = readLines(dbPath)
    for (var line in lines) {
        if (line.startsWith(sig + "|")) { hits.add(line) }
    }
    if (hits.size() > 0) { return hits }
    // a db entry may end in ":*" when the exact discriminator was never recorded
    for (var line in lines) {
        var star: Int = line.indexOf(":*|")
        if (star > 0) {
            var prefix: String = line.substring(0, star)
            if (sig.startsWith(prefix + ":")) { hits.add(line) }
        }
    }
    return hits
}

fieldAt(line: String, want: Int): String {
    var idx: Int = 0
    var start: Int = 0
    var i: Int = 0
    while (i < line.length()) {
        if (charAtStr(line, i) == "|") {
            if (idx == want) { return line.substring(start, i) }
            idx = idx + 1
            start = i + 1
        }
        i = i + 1
    }
    if (idx == want) { return line.substring(start, line.length()) }
    return ""
}

pad(s: String, n: Int): String {
    var out: String = s
    while (out.length() < n) { out = out + " " }
    // guarantee a separator even when the value overflows the column
    if (out.length() >= n) { out = out + " " }
    return out
}

cmdTriage(capDir: String, dbPath: String) {
    var buildTxt: String = readAll(capDir + "/build.txt")
    var runTxt: String = readAll(capDir + "/run.txt")
    var expected: String = readAll(capDir + "/expected.txt")
    var v: Verdict = classify(buildTxt, runTxt, expected)
    var sig: String = v.signature()
    println("== kofbug triage ==")
    println("capture   : " + capDir)
    println("kind      : " + v.kind)
    println("code      : " + v.code)
    println("detail    : " + v.detail)
    println("signature : " + sig)
    if (v.kind == "CLEAN") {
        println("verdict   : NO FAULT DETECTED - not a bug candidate")
        return
    }
    if (v.kind == "WRONGOUTPUT") { diffReport(runTxt, expected) ; println("") }
    var hits: List<String> = dedupLookup(dbPath, sig)
    if (hits.size() == 0) {
        println("dedup     : NOVEL - no filed issue carries this signature")
        println("verdict   : CANDIDATE - needs root-cause analysis")
        return
    }
    println("dedup     : " + hits.size() + " filed issue(s) share this signature")
    for (var h in hits) {
        println("            #" + fieldAt(h, 1) + "  " + fieldAt(h, 2))
    }
    println("verdict   : LIKELY DUPLICATE - confirm the mechanism differs before filing")
}

cmdIssue(capDir: String, tplPath: String) {
    var repro: String = readAll(capDir + "/main.kf")
    var expected: String = readAll(capDir + "/expected.txt")
    var actualBuild: String = readAll(capDir + "/build.txt")
    var actualRun: String = readAll(capDir + "/run.txt")
    var bytecode: String = readAll(capDir + "/bytecode.txt")
    var actual: String = actualRun
    if (actualRun.trim() == "") { actual = actualBuild }
    if (actualBuild.contains("error:")) { actual = actualBuild }
    // the Environment line is probed from the live toolchain, so an issue can
    // never claim a version the repro was not actually run against
    var env: String = readAll(capDir + "/env.txt").trim()
    if (env == "") { env = "Kof (version not captured), JVM target" }
    var tpl: String = readAll(tplPath)
    tpl = tpl.replace("@@ENVIRONMENT@@", env)
    tpl = tpl.replace("@@REPRO@@", repro.trim())
    tpl = tpl.replace("@@EXPECTED@@", expected.trim())
    tpl = tpl.replace("@@ACTUAL@@", actual.trim())
    tpl = tpl.replace("@@BYTECODE@@", bytecode.trim())
    println(tpl)
}

cmdVercmp(a: String, b: String) {
    var c: Int = cmpVersion(a, b)
    if (c < 0) { println("LT"); return }
    if (c > 0) { println("GT"); return }
    println("EQ")
}

// picks the highest version from a newline-separated list; the release feed is
// ordered by publish date, which is not the same as ordered by version
cmdLatest(listPath: String) {
    var lines: List<String> = readLines(listPath)
    var best: String = ""
    for (var raw in lines) {
        var v: String = raw.trim()
        if (v != "") {
            if (best == "") {
                best = v
            } else {
                if (cmpVersion(v, best) > 0) { best = v }
            }
        }
    }
    println(best)
}

cmdStats(dbPath: String) {
    var lines: List<String> = readLines(dbPath)
    var sigs: List<String> = listOf()
    var filed: Int = 0
    for (var line in lines) {
        if (line.trim() != "") {
            filed = filed + 1
            var s: String = fieldAt(line, 0)
            if (sigs.contains(s) == false) { sigs.add(s) }
        }
    }
    println("== kofbug stats ==")
    println("filed issues     : " + filed)
    println("distinct signatures : " + sigs.size())
    println("")
    println("signature breakdown:")
    for (var s in sigs) {
        var n: Int = 0
        for (var line in lines) {
            if (line.startsWith(s + "|")) { n = n + 1 }
        }
        println("  " + pad(s, 34) + n)
    }
}

cmdKnown(dbPath: String) {
    var lines: List<String> = readLines(dbPath)
    println("== filed issues ==")
    for (var line in lines) {
        if (line.trim() != "") {
            println("  #" + pad(fieldAt(line, 1), 6) + pad(fieldAt(line, 0), 30) + fieldAt(line, 2))
        }
    }
}

usage() {
    println("kofbug apoiador - mechanical support for the Kof bug hunt")
    println("")
    println("  triage <capdir> <db>        classify a captured run and dedup it")
    println("  issue  <capdir> <template>  emit the 8-section issue skeleton")
    println("  stats  <db>                 signature breakdown of filed issues")
    println("  known  <db>                 list every filed issue")
    println("  vercmp <a> <b>              compare two versions: LT | EQ | GT")
    println("  latest <file>               highest version in a newline list")
}

main(argv: String[]) {
    if (argv.length == 0) { usage(); return }
    var cmd: String = argv[0]
    if (cmd == "triage") {
        if (argv.length < 3) { println("triage needs <capdir> <db>"); return }
        cmdTriage(argv[1], argv[2])
        return
    }
    if (cmd == "issue") {
        if (argv.length < 3) { println("issue needs <capdir> <template>"); return }
        cmdIssue(argv[1], argv[2])
        return
    }
    if (cmd == "stats") {
        if (argv.length < 2) { println("stats needs <db>"); return }
        cmdStats(argv[1])
        return
    }
    if (cmd == "known") {
        if (argv.length < 2) { println("known needs <db>"); return }
        cmdKnown(argv[1])
        return
    }
    if (cmd == "vercmp") {
        if (argv.length < 3) { println("vercmp needs <a> <b>"); return }
        cmdVercmp(argv[1], argv[2])
        return
    }
    if (cmd == "latest") {
        if (argv.length < 2) { println("latest needs <file>"); return }
        cmdLatest(argv[1])
        return
    }
    usage()
}
