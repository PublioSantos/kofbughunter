String? maybeStr(Boolean flag) {
    if (flag) {
        return "hello"
    }
    return null
}
main() {
    var s1 = maybeStr(true)
    if (s1 != null) {
        println(s1.toUpperCase())
        println(s1.length())
    }
    var s2 = maybeStr(false)
    if (s2 != null) {
        println("got: " + s2)
    } else {
        println("was null")
    }
}
