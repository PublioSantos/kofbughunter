class Animal {
    String name
    constructor(n: String) { name = n }
    speak(): String { return name + " makes a sound" }
}
class Dog extends Animal {
    constructor(n: String) { super(n) }
    speak(): String { return name + " barks" }
}
main() {
    var d: Dog = Dog("Rex")
    println(d.speak())
    var a: Animal = d
    println(a.speak())
}
