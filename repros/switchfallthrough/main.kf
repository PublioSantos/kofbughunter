main() {
    var x = 1
    switch (x) {
        case 1: { println("one") }
        case 2: { println("two") }
        default: { println("other") }
    }
    var y = 3
    switch (y) {
        case 1: { println("one") }
        case 2: { println("two") }
        default: { println("other") }
    }
}
