class Vec2 {
    Int x
    Int y
    constructor(a: Int, b: Int) { x = a; y = b }
    plus(other: Vec2): Vec2 { return Vec2(x + other.x, y + other.y) }
    toString(): String { return "(" + x + "," + y + ")" }
}
main() {
    var a: Vec2 = Vec2(1, 2)
    var b: Vec2 = Vec2(3, 4)
    var c: Vec2 = a.plus(b)
    println(c.toString())
}
