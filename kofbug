#!/usr/bin/env bash
# kofbug - driver for the Kof bug hunt.
# Everything mechanical lives in the Kof apoiador (apoiador/main.kf).
# This wrapper only does what Kof has no API for: spawning processes.
set -uo pipefail

KOFROOT="${KOFROOT:-/home/publio/Downloads/install/kof-toolchain}"
PLATFORM="${KOF_PLATFORM:-linux-x86_64}"
UPSTREAM="${KOF_UPSTREAM:-KofLang/Kof4j}"

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APOIADOR="$SELF/apoiador/build/classes"
DB="$SELF/db/filed.txt"
TPL="$SELF/tpl/issue.md"
REPROS="$SELF/repros"
STAMP="$SELF/db/.update-check"

die() { echo "kofbug: $*" >&2; exit 1; }

# The active toolchain is whatever "current" points at, so an upgrade is just a
# repointed symlink and every path below follows along.
KOFHOME="${KOFHOME:-$KOFROOT/current}"

# First run has no symlink yet, and the Kof comparator cannot run before a
# toolchain is chosen — so the bootstrap alone leans on sort -V.
ensure_kofhome() {
  [ -e "$KOFHOME" ] && return 0
  [ "$KOFHOME" = "$KOFROOT/current" ] || die "KOFHOME does not exist: $KOFHOME"
  local best="" bestv="" v
  for d in "$KOFROOT"/kof-*-"$PLATFORM"; do
    [ -f "$d/VERSION" ] || continue
    v="$(cat "$d/VERSION")"
    if [ -z "$best" ] || [ "$(printf '%s\n%s\n' "$bestv" "$v" | sort -V | tail -1)" = "$v" ]; then
      best="$d"; bestv="$v"
    fi
  done
  [ -n "$best" ] || die "no Kof toolchain found under $KOFROOT"
  ln -sfn "$best" "$KOFROOT/current"
  echo "kofbug: toolchain pinned to $bestv"
}
ensure_kofhome

KOF="$KOFHOME/bin/kof"
JAVA="$KOFHOME/jdk/bin/java"
JAVAP="$KOFHOME/jdk/bin/javap"
RT="$KOFHOME/lib/kof.jar"

apoiador() { "$JAVA" -cp "$RT:$APOIADOR" Default.Main "$@"; }

installed_version() { cat "$KOFHOME/VERSION" 2>/dev/null || echo "0.0.0"; }

# The comparator runs on the active toolchain, which is exactly what an upgrade
# is trying to replace - so every call degrades to sort -V rather than deadlock
# on a toolchain too broken to run the apoiador. sort -V misorders pre-release
# suffixes, but "is there something newer" survives that.
vercmp() {
  local out
  if out="$(apoiador vercmp "$1" "$2" 2>/dev/null)" && [ -n "$out" ]; then
    echo "$out"; return 0
  fi
  if [ "$1" = "$2" ]; then echo EQ
  elif [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$2" ]; then echo LT
  else echo GT
  fi
}

# Release tags carry every platform; keep ours, strip to the bare version, and
# let the comparator pick the highest - the feed is date-ordered, not
# version-ordered.
latest_version() {
  local raw; raw="$(mktemp)"
  gh api "repos/$UPSTREAM/releases" --paginate \
     -q ".[] | select(.tag_name | test(\"-$PLATFORM\$\")) | .tag_name" 2>/dev/null \
    | sed -n "s/^kof-\(.*\)-$PLATFORM\$/\1/p" > "$raw"
  if [ ! -s "$raw" ]; then rm -f "$raw"; return 1; fi
  local out
  if ! out="$(apoiador latest "$raw" 2>/dev/null)" || [ -z "$out" ]; then
    out="$(sort -V "$raw" | tail -1)"
  fi
  rm -f "$raw"
  echo "$out"
}

# The Environment section of every issue is probed here, so a filed issue can
# never claim a version the repro was not actually run against.
env_line() {
  local raw jdk vendor build os
  raw="$("$JAVA" -version 2>&1)"
  jdk="$(echo "$raw"    | sed -n '1s/.*version "\([^"]*\)".*/\1/p')"
  vendor="$(echo "$raw" | sed -n '2s/.*Runtime Environment \([^ ]*\).*/\1/p')"
  build="$(echo "$raw"  | sed -n '2s/.*(build \([^)]*\)).*/\1/p')"
  # the vendor token drops the release-train suffix that the build string keeps
  case "$build" in
    *-LTS) [ "${vendor%-LTS}" = "$vendor" ] && vendor="$vendor-LTS" ;;
  esac
  os="$(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME")"
  printf 'Kof %s, JVM target / OpenJDK %s (%s) / %s, %s\n' \
    "$(installed_version)" "${jdk:-unknown}" "${vendor:-${build:-unknown}}" \
    "${os:-unknown}" "$(uname -m)"
}

cmd_build() {
  ( cd "$SELF/apoiador" && "$KOF" build . --target jvm ) || die "apoiador failed to compile"
  echo "apoiador rebuilt"
}

cmd_version() {
  local cur latest; cur="$(installed_version)"
  echo "installed : kof $cur  ($(readlink -f "$KOFHOME"))"
  if ! latest="$(latest_version)" || [ -z "$latest" ]; then
    echo "upstream  : unreachable"; return 0
  fi
  echo "upstream  : kof $latest  ($UPSTREAM, $PLATFORM)"
  case "$(vercmp "$cur" "$latest")" in
    LT) echo "status    : OUTDATED - run './kofbug upgrade'" ;;
    GT) echo "status    : AHEAD of the release feed (local build?)" ;;
    *)  echo "status    : current" ;;
  esac
}

cmd_upgrade() {
  local cur latest; cur="$(installed_version)"
  latest="$(latest_version)" || die "cannot reach the release feed for $UPSTREAM"
  [ -n "$latest" ] || die "no $PLATFORM release found upstream"
  if [ "$(vercmp "$cur" "$latest")" != "LT" ]; then
    echo "kof $cur is current (latest upstream: $latest)"
    date +%s > "$STAMP"; return 0
  fi

  echo "kofbug: upgrading kof $cur -> $latest"
  local tag="kof-$latest-$PLATFORM" tgz="kof-$latest-$PLATFORM.tar.gz"
  ( cd "$KOFROOT" && gh release download "$tag" --repo "$UPSTREAM" \
      --pattern "$tgz" --pattern SHA256SUMS --clobber ) \
    || die "download of $tag failed"

  # The release ships SHA256SUMS; refuse to unpack a tarball that fails it.
  ( cd "$KOFROOT" && grep -F "$tgz" SHA256SUMS | sha256sum -c - ) \
    || die "checksum mismatch on $tgz - refusing to install"

  ( cd "$KOFROOT" && tar xzf "$tgz" ) || die "extraction of $tgz failed"
  [ -f "$KOFROOT/kof-$latest-$PLATFORM/VERSION" ] \
    || die "extracted tree has no VERSION file - layout changed?"

  local prev; prev="$(readlink -f "$KOFHOME")"
  ln -sfn "$KOFROOT/kof-$latest-$PLATFORM" "$KOFROOT/current"
  echo "kofbug: toolchain now kof $latest"

  # A new compiler that cannot build the apoiador is itself a finding, so keep
  # the working classes and say so rather than leaving the tool broken.
  local backup; backup="$(mktemp -d)"
  cp -r "$APOIADOR/." "$backup/" 2>/dev/null || true
  if ( cd "$SELF/apoiador" && "$KOF" build . --target jvm ) >/dev/null 2>&1; then
    echo "kofbug: apoiador rebuilt with kof $latest"
  else
    rm -rf "$APOIADOR"; mkdir -p "$APOIADOR"; cp -r "$backup/." "$APOIADOR/"
    echo "kofbug: WARNING - kof $latest cannot compile the apoiador." >&2
    echo "kofbug: kept the classes built by $(basename "$prev"); this is a bug candidate." >&2
    echo "kofbug: see './kofbug build' for the errors." >&2
  fi
  rm -rf "$backup"
  date +%s > "$STAMP"

  echo "kofbug: run './kofbug regress' to see which filed bugs $latest fixed"
}

# Runs before anything that invokes the compiler. Cached for a day so a hunt
# with dozens of repros does not hit the release API on every single run.
auto_check() {
  [ -n "${KOFBUG_NO_UPDATE:-}" ] && return 0
  # A source build of beta-0.4.0 always carries a LOWER version string than the
  # newest release (the branch is ahead, the tag is not), so the plain version
  # compare below would "upgrade" it straight back to the release and silently
  # re-introduce every bug the branch already fixed. The pin marker is what
  # keeps a hunt honest: the branch is the reference, never the tag.
  [ -f "$KOFHOME/.source-build" ] && return 0
  command -v gh >/dev/null 2>&1 || return 0
  local cur latest; cur="$(installed_version)"
  if ! latest="$(latest_version)" || [ -z "$latest" ]; then
    return 0   # offline is not a reason to block a hunt
  fi
  date +%s > "$STAMP"
  [ "$(vercmp "$cur" "$latest")" = "LT" ] || return 0
  echo "kofbug: kof $latest is out (installed: $cur)" >&2
  cmd_upgrade
}

# Re-run every repro and report only what MOVED against its recorded baseline.
# A repro that was always clean is a control, not a fix - after an upgrade the
# only interesting lines are the changes.
cmd_regress() {
  local n=0 moved=0
  for d in "$REPROS"/*/; do
    [ -d "$d" ] || continue
    [ -f "$d/main.kf" ] || continue
    local name; name="$(basename "$d")"
    n=$((n + 1))
    cmd_run "$name" >/dev/null 2>&1
    local now was; now="$(cat "$d/.cap/verdict" 2>/dev/null)"
    was="$(cat "$d/baseline.txt" 2>/dev/null)"
    [ "$now" = "$was" ] && continue
    moved=$((moved + 1))
    if [ "$now" = "CLEAN" ]; then
      printf '  %-24s FIXED    %s -> CLEAN\n' "$name" "$was"
    elif [ "$was" = "CLEAN" ]; then
      printf '  %-24s BROKE    CLEAN -> %s\n' "$name" "$now"
    else
      printf '  %-24s CHANGED  %s -> %s\n' "$name" "$was" "$now"
    fi
  done
  echo
  if [ "$moved" -eq 0 ]; then
    echo "$n repros re-run against kof $(installed_version); nothing moved"
  else
    echo "$n repros re-run against kof $(installed_version); $moved moved"
    echo "FIXED lines: check db/filed.txt - those issues may be closeable"
    echo "accept the new state with './kofbug baseline'"
  fi
  return 0
}

# Freeze the current verdicts as the new baseline, after the moves were reviewed.
cmd_baseline() {
  local n=0
  for d in "$REPROS"/*/; do
    [ -f "$d/.cap/verdict" ] || continue
    cp "$d/.cap/verdict" "$d/baseline.txt"; n=$((n + 1))
  done
  echo "baseline frozen for $n repros at kof $(installed_version)"
}

# Build beta-0.4.0 from a Kof4j checkout and pin the toolchain to it. Hunting
# against the release tag reports bugs the branch already fixed, so the branch
# is the only honest reference for "is this still broken".
cmd_tip() {
  local src="${1:-}"
  [ -n "$src" ] || die "tip needs the path to a Kof4j checkout"
  [ -d "$src/.git" ] || die "$src is not a git repo"
  local jdk="$KOFROOT/kof-0.4.2-beta-$PLATFORM/jdk"
  [ -x "$jdk/bin/java" ] || die "no JDK found at $jdk"
  echo "kofbug tip: building $src ..."
  JAVA_HOME="$jdk" mvn -q -o -f "$src/pom.xml" clean package -DskipTests \
    || die "mvn build failed"
  JAVA_HOME="$jdk" bash "$src/scripts/package.sh" --skip-build >/dev/null 2>&1 \
    || die "package.sh failed"
  local built; built="$(find "$src/dist" -maxdepth 1 -type d -name "kof-*-$PLATFORM" | head -1)"
  [ -n "$built" ] || die "no packaged toolchain under $src/dist"
  rm -rf "$KOFROOT/kof-beta-tip"
  cp -r "$built" "$KOFROOT/kof-beta-tip"
  ln -sfn "../kof-0.4.2-beta-$PLATFORM/jdk" "$KOFROOT/kof-beta-tip/jdk"
  # the marker auto_check reads, so the release tag can never overwrite this
  git -C "$src" rev-parse --short HEAD > "$KOFROOT/kof-beta-tip/.source-build"
  ln -sfn kof-beta-tip "$KOFROOT/current"
  echo "kofbug tip: pinned to $(cat "$KOFROOT/kof-beta-tip/VERSION") @ $(cat "$KOFROOT/kof-beta-tip/.source-build")"
}

# Forms that are NOT Kof. Every one of these already produced a false issue:
# the bot wrote Kotlin/Java, the compiler refused it correctly, and the refusal
# got filed as a bug. Worse, filed issues pulled the Kof agent toward
# IMPLEMENTING them - so a bad repro does not just waste triage, it drifts the
# language. Source of truth = training/ + learn/ + docs/ in the Kof4j repo.
lint_repro() {
  local f="$1" bad=0
  check() {
    grep -nE "$1" "$f" >/dev/null 2>&1 || return 0
    printf '  %-22s %s\n' "$2" "$3" >&2; bad=1
  }
  check '(^|[^A-Za-z_])val[[:space:]]+[A-Za-z_]' 'val' 'use var (maintainer: val is not for declarations)'
  check '\bStringBuilder\b'          'StringBuilder' 'Java class; Kof has no StringBuilder'
  check '\bMath\.'                   'Math.'         'Java class; Kof has math.* (kof.math)'
  check '\bmutableListOf\b'          'mutableListOf' 'Kotlin; listOf() is already mutable'
  check '\bPair[<(]'                 'Pair'          'Kotlin; declare record Pair(K first, V second)'
  check '\{[[:space:]]*it[[:space:]]' 'it'           'Kotlin implicit lambda; Kof uses (x: T) -> expr'
  check '\.(any|all|none|sorted)\('  'any/all/none'  'Kotlin extensions; not Kof List methods'
  check '\?:'                        '?:'            'elvis does not exist (grammar 5.3)'
  check '\?\.'                       '?.'            'safe-call does not exist; ? is a type suffix'
  check '!!'                         '!!'            'non-null assertion does not exist'
  check '[0-9A-Za-z_)]\.\.[0-9A-Za-z_(]' '..'        'range operator does not exist (grammar 5.3)'
  check '(^|[^A-Za-z_])is[[:space:]]+[A-Z]' 'is'     'use instanceof (is is not a Kof operator)'
  check '(^|[^A-Za-z_])object[[:space:]]+[A-Z]' 'object' 'Kotlin declaration; not a Kof type'
  check '(^|[^A-Za-z_])open[[:space:]]+class' 'open' 'not a Kof modifier'
  check '\$\{'                       '${}'           'no string interpolation (lexical 4.1)'
  check '"""'                        '"""'           'no triple-quoted string (lexical 4.1)'
  return $bad
}

cmd_lint() {
  local name="${1:-}"; [ -n "$name" ] || die "lint needs a repro name"
  local f="$REPROS/$name/main.kf"
  [ -f "$f" ] || die "no such repro: $name"
  if lint_repro "$f"; then
    echo "kofbug lint: $name uses only native Kof forms"
  else
    die "$name uses non-Kof forms (see above) - fix the repro, it is not a bug"
  fi
}

cmd_new() {
  local name="${1:-}"; [ -n "$name" ] || die "new needs a name"
  local d="$REPROS/$name"
  [ -e "$d" ] && die "$name already exists"
  mkdir -p "$d"
  cat > "$d/main.kf" <<'KF'
main() {
    println("replace me with the repro")
}
KF
  printf 'replace me with the expected output\n' > "$d/expected.txt"
  echo "$d/main.kf"
}

# build + run + javap, capture everything, then hand off to the Kof apoiador
cmd_run() {
  local name="${1:-}"; [ -n "$name" ] || die "run needs a repro name"
  local d="$REPROS/$name"
  [ -d "$d" ] || die "no such repro: $name"
  # Gate BEFORE the compiler: a repro written in Kotlin/Java is not a bug
  # report, it is a broken repro. Catching it here is what stops it becoming
  # an issue - and stops the issue drifting the language.
  if ! lint_repro "$d/main.kf"; then
    die "$name uses non-Kof forms (see above) - fix the repro, it is not a bug"
  fi

  local cap="$d/.cap"
  rm -rf "$cap" "$d/build"; mkdir -p "$cap"

  cp "$d/main.kf" "$cap/main.kf"
  [ -f "$d/expected.txt" ] && cp "$d/expected.txt" "$cap/expected.txt"
  env_line > "$cap/env.txt"

  ( cd "$d" && "$KOF" build . --target jvm ) > "$cap/build.txt" 2>&1
  echo "$?" > "$cap/build.rc"

  if [ -d "$d/build/classes" ]; then
    "$JAVA" -cp "$RT:$d/build/classes" Default.Main > "$cap/run.txt" 2>&1
    echo "$?" > "$cap/run.rc"
    # dump every emitted class; the interesting one is rarely just Main
    : > "$cap/bytecode.txt"
    while IFS= read -r c; do
      echo "// ===== $(basename "$c" .class) =====" >> "$cap/bytecode.txt"
      "$JAVAP" -c -p -verbose "$c" >> "$cap/bytecode.txt" 2>&1
    done < <(find "$d/build/classes" -name '*.class' | sort)
  else
    : > "$cap/run.txt"; echo "na" > "$cap/run.rc"; : > "$cap/bytecode.txt"
  fi

  local tri; tri="$(apoiador triage "$cap" "$DB")"
  echo "$tri"
  echo "$tri" | sed -n 's/^signature *: *//p' > "$cap/verdict"
  # first capture of a repro defines what the toolchain did back then, so a
  # later upgrade has something to be compared against
  [ -s "$d/baseline.txt" ] || cp "$cap/verdict" "$d/baseline.txt"
}

cmd_triage() {
  local name="${1:-}"; [ -n "$name" ] || die "triage needs a repro name"
  apoiador triage "$REPROS/$name/.cap" "$DB"
}

cmd_issue() {
  local name="${1:-}"; [ -n "$name" ] || die "issue needs a repro name"
  local cap="$REPROS/$name/.cap"
  [ -d "$cap" ] || die "no capture for $name - run it first"
  apoiador issue "$cap" "$TPL"
}

# trim the captured bytecode down to one class before emitting the issue
cmd_focus() {
  local name="${1:-}" cls="${2:-}"
  [ -n "$name" ] && [ -n "$cls" ] || die "focus needs <repro> <ClassName>"
  local cap="$REPROS/$name/.cap"
  [ -f "$cap/bytecode.txt" ] || die "no captured bytecode for $name"
  awk -v c="// ===== $cls =====" '
    $0==c {keep=1; print; next}
    /^\/\/ ===== / {keep=0}
    keep {print}' "$cap/bytecode.txt" > "$cap/bytecode.focus" \
    || die "focus failed"
  [ -s "$cap/bytecode.focus" ] || die "class $cls not found in capture"
  mv "$cap/bytecode.focus" "$cap/bytecode.txt"
  echo "bytecode narrowed to $cls"
}

cmd_stats() { apoiador stats "$DB"; }
cmd_known() { apoiador known "$DB"; }

# record a freshly filed issue so future runs dedup against it
cmd_file() {
  local sig="${1:-}" num="${2:-}"; shift 2 2>/dev/null
  local title="${*:-}"
  [ -n "$sig" ] && [ -n "$num" ] && [ -n "$title" ] || die "file needs <signature> <number> <title>"
  printf '%s|%s|%s\n' "$sig" "$num" "$title" >> "$DB"
  echo "recorded $sig -> #$num"
}

# ─── PR WORKFLOW ───────────────────────────────────────────────────────────
# kofbug pr <repro> <issue#> <kof4j-dir> <patch-file>
#
# Opens a PR from PublioSantos/Kof4j against KofLang/Kof4j:beta-0.4.0.
# The caller supplies:
#   <repro>       - repro name (for the PR body's "Test reproducer" section)
#   <issue#>      - upstream issue number to link ("Closes #N")
#   <kof4j-dir>   - local checkout of Kof4j (must already be on the fix branch)
#   <patch-file>  - path to a diff/patch OR "." meaning the branch is already
#                   committed and just needs pushing
#
# The fix branch must already exist in <kof4j-dir>; this command only builds,
# verifies, commits if there are staged changes, pushes, and opens the PR.
#
cmd_pr() {
  local repro="${1:-}" issue="${2:-}" kof4j="${3:-}" patch="${4:-.}"
  [ -n "$repro" ] && [ -n "$issue" ] && [ -n "$kof4j" ] \
    || die "pr needs <repro> <issue#> <kof4j-dir> [patch-file]"

  local cap="$REPROS/$repro/.cap"
  [ -d "$cap" ] || die "no capture for $repro — run it first"

  [ -d "$kof4j/.git" ] || die "$kof4j is not a git repo"

  local branch; branch="$(git -C "$kof4j" branch --show-current 2>/dev/null)"
  [ -n "$branch" ] || die "could not determine current branch in $kof4j"

  # apply patch if given (not ".")
  if [ "$patch" != "." ] && [ -f "$patch" ]; then
    git -C "$kof4j" apply "$patch" || die "patch did not apply cleanly"
  fi

  # build — Maven if available, else warn and continue
  if command -v mvn &>/dev/null; then
    echo "kofbug pr: building $kof4j ..."
    JAVA_HOME="$KOFHOME/jdk" mvn -C -q -f "$kof4j/pom.xml" clean package -DskipTests \
      || die "mvn build failed — fix compilation errors before opening PR"
    # package into dist/ so we can test with the patched jar
    JAVA_HOME="$KOFHOME/jdk" bash "$kof4j/scripts/package.sh" --skip-build 2>/dev/null \
      || echo "kofbug pr: package.sh warning (non-fatal)"
    echo "kofbug pr: build OK"
  else
    echo "kofbug pr: WARNING — Maven not found; skipping local build verification"
    echo "kofbug pr: CI will be the safety net"
  fi

  # commit staged changes if any (patch might have left them unstaged)
  if ! git -C "$kof4j" diff --quiet HEAD 2>/dev/null; then
    git -C "$kof4j" add -A
    git -C "$kof4j" commit -m "$(cat << CMSG
fix(#${issue}): fix from kofbughunter automated workflow

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
CMSG
)"
  fi

  # push to fork
  git -C "$kof4j" push fork "$branch" \
    || die "push to fork failed"

  # issue title from filed.txt
  local issue_title; issue_title="$(grep "|${issue}|" "$DB" | cut -d'|' -f3 | head -1)"
  [ -n "$issue_title" ] || issue_title="Bug #${issue}"

  # repro code for PR body
  local repro_code; repro_code="$(cat "$REPROS/$repro/main.kf")"
  local expected; expected="$(cat "$REPROS/$repro/expected.txt" 2>/dev/null || echo "(see issue)")"
  local actual; actual="$(cat "$cap/run.txt" 2>/dev/null | head -20)"

  gh pr create \
    --repo KofLang/Kof4j \
    --base beta-0.4.0 \
    --head "PublioSantos:${branch}" \
    --title "fix(#${issue}): ${issue_title}" \
    --body "$(cat << PRBODY
## Summary

Suggested fix for issue #${issue}: ${issue_title}

## Test reproducer

\`\`\`kof
${repro_code}
\`\`\`

**Expected:**
\`\`\`
${expected}
\`\`\`

**Actual before fix:**
\`\`\`
${actual}
\`\`\`

Closes #${issue}

> Generated by [kofbughunter](https://github.com/PublioSantos/kofbughunter) automated PR workflow.
PRBODY
)"
}
# ────────────────────────────────────────────────────────────────────────────

cmd_list() {
  [ -d "$REPROS" ] || return 0
  for d in "$REPROS"/*/; do
    [ -d "$d" ] || continue
    local n; n="$(basename "$d")"
    if [ -f "$d/.cap/build.rc" ]; then
      printf '  %-28s captured\n' "$n"
    else
      printf '  %-28s not run\n' "$n"
    fi
  done
}

usage() {
  echo "kofbug - driver for the Kof $(installed_version) bug hunt"
  cat <<'USAGE'

  new <name>              scaffold repros/<name>/main.kf
  lint <name>             reject non-Kof forms (Kotlin/Java) before they become issues
  tip <kof4j-dir>         build beta-0.4.0 from source and pin the toolchain to it
  run <name>              lint + build + run + javap, capture, triage
  triage <name>           re-triage an existing capture
  issue <name>            emit the 8-section issue skeleton
  focus <name> <Class>    narrow captured bytecode to one class
  list                    repros and whether they have been run
  stats                   signature breakdown of filed issues
  known                   list every filed issue
  file <sig> <n> <title>  record a newly filed issue for dedup
  pr <repro> <issue#> <kof4j-dir> [patch]  build+push+open PR to beta-0.4.0
  build                   recompile the Kof apoiador
  version                 installed vs. latest upstream kof
  upgrade                 download + verify + install the latest kof
  regress                 re-run every repro; report what moved vs. baseline
  baseline                freeze the current verdicts as the new baseline

Hunt against the LATEST RELEASE (auto_check does this automatically).
`tip <kof4j-dir>` builds from the local checkout and pins to it — only use
when the local checkout has commits not yet in any release.

Every command that invokes the compiler checks the release feed first (once a
day); an outdated toolchain is upgraded automatically, EXCEPT when pinned to a
source build. Set KOFBUG_NO_UPDATE=1 to pin the current version.

Repros must use only native Kof. `run` lints first and refuses Kotlin/Java
